rules_version = '2';

// The application reaches Firestore only from the server, which uses the Admin
// SDK and bypasses these rules. Client-side Firestore access is never used, so
// denying everything is correct: it stops anyone reading `orders` or
// `licencePool` straight from a browser. Those hold customer contact details
// and unissued licence keys.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
