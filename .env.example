# Server Configuration
# PORT is injected by Cloud Run in production; 3000 is the local default.
PORT=3000
NODE_ENV=development

# Guards /api/admin/data when NODE_ENV=production. Leave unset to keep the
# endpoint disabled (404); set it and pass the same value as x-admin-token.
ADMIN_TOKEN=

# Firestore
# Credentials come from Application Default Credentials. On Cloud Run the
# runtime service account supplies them automatically -- there is no key file
# and no GOOGLE_SERVICE_ACCOUNT_* variable. Locally, run
# `gcloud auth application-default login`.
#
# Only needed when ADC cannot infer the project (most local setups):
GOOGLE_CLOUD_PROJECT=
# Only when using a named (non-default) Firestore database:
FIRESTORE_DATABASE_ID=
# Point at a local emulator instead of real Firestore:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Cloud Storage bucket for customer document uploads. Defaults to the
# project's own bucket (<project>.appspot.com).
DOCUMENTS_BUCKET=
