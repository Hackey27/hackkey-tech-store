# Server Configuration
# PORT is injected by Cloud Run in production; 3000 is the local default.
PORT=3000
NODE_ENV=development

# Guards /api/admin/data when NODE_ENV=production. Leave unset to keep the
# endpoint disabled (404); set it and pass the same value as x-admin-token.
ADMIN_TOKEN=

# Google Sheets Data-Access Abstraction Configuration (Optional for Phase 1 preview)
# Set these variables to bind live Google Sheets inventory data
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
