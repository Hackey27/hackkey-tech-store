# Server Configuration
# PORT is injected by Cloud Run in production; 3000 is the local default.
PORT=3000
NODE_ENV=development

# Firestore
# Credentials come from Application Default Credentials. On Cloud Run the
# runtime service account supplies them automatically -- there is no key file
# and no GOOGLE_SERVICE_ACCOUNT_* variable. Locally, run
# `gcloud auth application-default login`.
#
# Only needed when ADC cannot infer the project (most local setups):
GOOGLE_CLOUD_PROJECT=
# Only when using a named (non-default) Firestore database:
FIRESTORE_DATABASE_ID=
# Point at a local emulator instead of real Firestore:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Cloud Storage bucket for customer document uploads. Defaults to the
# project's own bucket (<project>.appspot.com).
DOCUMENTS_BUCKET=

# Payments (Paystack)
# Secret Manager in production. Server only — never bundled into dist/.
# The prefix decides the mode: sk_test_ or sk_live_. In production the server
# refuses to start without it.
PAYSTACK_SECRET_KEY=
# Used to build the payment callback URL, e.g. https://store.hackeytech.com
PUBLIC_BASE_URL=

# Email (Resend). A send failure is recorded on the order, never fatal.
MAIL_PROVIDER_API_KEY=
SELLER_ALERT_EMAIL=
# Sent from the send. subdomain, which holds the SPF/DKIM records.
MAIL_FROM=Hack-Key Tech <orders@send.hackeytech.com>
# Replies go to the real inbox on the root domain.
MAIL_REPLY_TO=orders@hackeytech.com
